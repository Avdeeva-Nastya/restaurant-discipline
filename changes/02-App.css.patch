diff --git a/src/App.css b/src/App.css
index 89225ed..59d2e6d 100644
--- a/src/App.css
+++ b/src/App.css
@@ -81,6 +81,42 @@ body { background: #15100C; -webkit-font-smoothing: antialiased; }
 /* --- Keyframes: покадровые сценарии анимаций --- */
 
 
+/* --- Каркас страницы: на десктопе «телефон» по центру,
+   на мобильном — вся высота экрана. Раньше этих правил НЕ БЫЛО
+   (в App.css остались только media-запросы к несуществующим
+   классам) — поэтому вёрстка «съезжала»: рамка и подпись не
+   имели размеров. Добавили минимальный набор. */
+.mb-root {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  padding: 24px 16px;
+  background: #15100C;
+}
+
+/* Подпись над телефоном («Мур-мур бистро · Ресторан») */
+.mb-caption {
+  color: var(--ink-soft, #8A7358);
+  font-weight: 800;
+  font-size: 13px;
+}
+
+/* Рамка «телефона»: фиксированный размер макета + мягкая тень */
+.mb-frame {
+  width: min(430px, 100%);
+  height: min(880px, calc(100vh - 90px));
+  border-radius: 34px;
+  border: 2px solid #3A2A1E;
+  box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .8);
+  overflow: hidden;
+}
+
+/* Запретили браузеру добавлять собственные отступы у <main> */
+.mb-content > main, main.mb-content { margin: 0; }
+
 /* --- Телефон: на узких экранах макет занимает весь экран без рамки --- */
 @media (max-width: 520px) {
   .mb-root { padding: 0; }
